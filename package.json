{
  "name": "video-creation-workspace",
  "private": true,
  "description": "视频创作：DesireCore 视频创作应用，复用 OpenFilm 的文件格式、Studio 编辑器和渲染内核。",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm build && node desirecore/cli.mjs start --home .dev/video-creation --project examples/first-film",
    "build": "pnpm --filter @desirecore-agent/video-creation build:ui",
    "test": "node --test --test-concurrency=1 desirecore/application-lock.test.mjs desirecore/runtime.test.mjs desirecore/service.integration.test.mjs desirecore/release.test.mjs packages/openfilm/studio/server/reviews.test.mjs desirecore/review.integration.test.mjs desirecore/patch-contract.test.mjs desirecore/scene-source.integration.test.mjs packages/openfilm/studio/server/scene-source.test.mjs packages/openfilm/src/review-derivatives.test.mjs packages/openfilm/src/review-observation.test.mjs packages/openfilm/src/review-findings.test.mjs && pnpm --filter @desirecore-agent/video-creation test:smoke",
    "typecheck": "pnpm --filter @desirecore-agent/video-creation typecheck",
    "audit:public": "node scripts/audit-public.mjs",
    "skills:sync": "node scripts/sync-skills.mjs",
    "examples:sync": "node scripts/sync-examples.mjs",
    "dev:core": "pnpm --filter @desirecore-agent/video-creation dev",
    "test:reliability": "node --test --test-concurrency=1 packages/openfilm/studio/server/film.test.mjs packages/openfilm/studio/server/export-snapshot.test.mjs packages/openfilm/studio/server/exports-reliability.test.mjs",
    "app:release": "node desirecore/release.mjs",
    "build:motion": "node scripts/build-motion-sdk.mjs",
    "samples:motion": "node examples/general-motion/prepare-samples.mjs",
    "test:motion": "node --test --test-concurrency=1 packages/openfilm/src/motion.test.mjs packages/openfilm/studio/server/motion-project.test.mjs packages/openfilm/studio/server/saved.test.mjs packages/openfilm/studio/server/closure.test.mjs desirecore/export-options.test.mjs desirecore/general-motion-smoke.test.mjs packages/openfilm/studio/ui/src/lib/motion-editor.test.ts packages/openfilm/studio/ui/src/editor/undo.test.ts scripts/build-motion-sdk.test.mjs",
    "test:motion:runtime": "node --test --test-concurrency=1 packages/openfilm/src/motion-host.test.mjs packages/openfilm/studio/server/motion-pageframes.test.mjs desirecore/motion.integration.test.mjs packages/openfilm/src/render-alpha.test.mjs packages/openfilm/studio/server/motion-stage.test.mjs && node scripts/test-review-runtime.mjs",
    "test:regressions": "node --test --test-concurrency=1 packages/openfilm/studio/server/watch.test.mjs packages/openfilm/studio/server/project-sync.test.mjs packages/openfilm/studio/server/providers/mimo.test.mjs packages/openfilm/studio/server/providers/index.test.mjs packages/openfilm/studio/ui/src/lib/project-metadata.test.ts desirecore/media-get.test.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.5.2",
    "@changesets/cli": "2.31.1",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "ajv": "8.17.1"
  }
}
